---
import { site } from '../data/site';
---
<section class="container-x py-20" data-testid="contact-cta">
  <div class="relative overflow-hidden rounded-[2rem] bg-brand px-6 py-14 text-white sm:px-14">
    <img src="/images/logo.png" alt="" class="pointer-events-none absolute -bottom-20 -right-16 h-72 w-72 opacity-15 brightness-0 invert" />
    <div class="relative grid gap-8 md:grid-cols-2 md:items-center">
      <div>
        <p class="font-mono text-xs uppercase tracking-[0.18em] text-white/80">Kontakt oss</p>
        <h2 class="mt-3 text-3xl font-extrabold !text-white sm:text-4xl">Ønsker du å trene teamet ditt?</h2>
        <p class="mt-4 text-white/85">Vi setter oss ned med dere og lager scenario tilpasset deres læringsmål.</p>
      </div>
      <div class="flex flex-col gap-3 md:items-end">
        <a href={site.phoneHref} class="font-display text-3xl font-extrabold hover:text-cyan sm:text-4xl" data-testid="cta-phone">{site.phone}</a>
        <a href="/kontakt/" class="btn mt-2 bg-white text-brand hover:bg-ice" data-testid="cta-contact-button">Send oss en melding →</a>
      </div>
    </div>
  </div>
</section>
