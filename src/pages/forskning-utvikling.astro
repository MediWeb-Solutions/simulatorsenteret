---
import Layout from '@/layouts/Layout.astro';
import PageHero from '@/components/PageHero.astro';
import { research } from '@/data/site';
const theses = [...research.phd.map((t) => ({ ...t, kind: 'Doktorgrad' })), ...research.master.map((t) => ({ ...t, kind: 'Mastergrad' }))];
---
<Layout title="Forskning / utvikling" active="forskning">
  <PageHero eyebrow="02 / Forskning og utvikling" title="Forskning som gjør simuleringen bedre" lead="Medisinsk SimulatorSenter driver forskning og fagutvikling for å bli stadig bedre på feltet medisinsk simulering. Her finner du prosjekter som faller under samlebetegnelsen forskning og utvikling." image="/images/training.jpg" />

  <section class="container-x py-20" data-testid="theses-section">
    <p class="eyebrow">Doktor- og mastergrader</p>
    <h2 class="mt-3 text-3xl font-bold">Avhandlinger</h2>
    <div class="mt-10 grid gap-5 md:grid-cols-3">
      {theses.map((t, i) => (
        <a href={t.href} target="_blank" rel="noopener" class="group flex flex-col rounded-3xl border border-slate-200 bg-white p-7 transition-[border-color,box-shadow,transform] duration-300 hover:-translate-y-1 hover:border-brand/40 hover:shadow-xl" data-testid={`thesis-link-${i}`}>
          <div class="flex items-center justify-between">
            <span class:list={['rounded-full px-3 py-1 font-mono text-xs', t.kind === 'Doktorgrad' ? 'bg-brand text-white' : 'bg-ice text-brand']}>{t.kind}</span>
            <span class="font-mono text-sm text-slate-500">{t.year}</span>
          </div>
          <h3 class="mt-5 flex-1 text-lg font-bold leading-snug group-hover:text-brand">«{t.title}»</h3>
          <p class="mt-4 text-sm text-slate-600">{t.author}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="border-y border-slate-200 bg-white py-20" data-testid="articles-section">
    <div class="container-x">
      <p class="eyebrow">Publikasjoner</p>
      <h2 class="mt-3 text-3xl font-bold">Tidsskriftsartikler</h2>
      <ul class="mt-10 divide-y divide-slate-200 border-y border-slate-200">
        {research.articles.map((a, i) => (
          <li class="grid gap-3 py-7 md:grid-cols-12 md:gap-8" data-testid={`article-item-${i}`}>
            <span class="font-mono text-sm text-brand md:col-span-1">{a.year}</span>
            <div class="md:col-span-11">
              {a.href ? <a href={a.href} target="_blank" rel="noopener" class="font-display text-lg font-bold text-slate-900 hover:text-brand">{a.title} ↗</a> : <p class="font-display text-lg font-bold text-slate-900">{a.title}</p>}
              <p class="mt-2 text-sm text-slate-600">{a.authors}</p>
              <p class="mt-1 text-sm italic text-slate-500">{a.journal}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="container-x py-20" data-testid="posters-section">
    <p class="eyebrow">Internasjonale kongresser</p>
    <h2 class="mt-3 text-3xl font-bold">Postere</h2>
    <div class="mt-10 grid gap-5 md:grid-cols-3">
      {research.posters.map((p, i) => (
        <article class="relative overflow-hidden rounded-3xl bg-navy p-8" data-testid={`poster-card-${i}`}>
          <img src="/images/logo.png" alt="" class="absolute -right-10 -top-10 h-36 w-36 opacity-10" />
          <p class="font-mono text-xs uppercase tracking-[0.18em] text-cyan">{p.event} · {p.year}</p>
          <h3 class="mt-4 text-xl font-bold leading-snug !text-white">{p.title}</h3>
        </article>
      ))}
    </div>
  </section>
</Layout>
