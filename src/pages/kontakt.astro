---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import ContactForm from '../components/ContactForm.astro';
import { site } from '../data/site';
---
<Layout title="Kontakt" active="kontakt">
  <PageHero eyebrow="Kontakt oss" title="Ta kontakt med oss" lead="Har du spørsmål om kurs, simulering eller samarbeid? Ring oss, send en e-post eller bruk skjemaet nedenfor." />
  <section class="container-x grid gap-10 py-20 lg:grid-cols-12" data-testid="contact-section">
    <div class="space-y-5 lg:col-span-5">
      <a href={site.phoneHref} class="block rounded-3xl bg-brand p-8 text-white transition-colors hover:bg-brand-dark" data-testid="contact-phone">
        <p class="font-mono text-xs uppercase tracking-[0.18em] text-white/80">Telefon</p>
        <p class="mt-2 font-display text-3xl font-extrabold">{site.phone}</p>
      </a>
      <a href={`mailto:${site.email}`} class="block rounded-3xl border border-slate-200 bg-white p-8 transition-colors hover:border-brand/40" data-testid="contact-email">
        <p class="eyebrow">E-post</p>
        <p class="mt-2 break-all font-display text-lg font-bold text-navy">{site.email}</p>
      </a>
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2">
        <div class="rounded-3xl border border-slate-200 bg-white p-7" data-testid="contact-visit-address">
          <p class="eyebrow">Besøk oss gjerne</p>
          <address class="mt-3 not-italic text-sm leading-7 text-slate-700">{site.visit.map((l) => <>{l}<br /></>)}</address>
        </div>
        <div class="rounded-3xl border border-slate-200 bg-white p-7" data-testid="contact-post-address">
          <p class="eyebrow">Postadresse</p>
          <address class="mt-3 not-italic text-sm leading-7 text-slate-700">{site.post.map((l) => <>{l}<br /></>)}</address>
        </div>
      </div>
    </div>
    <div class="lg:col-span-7"><ContactForm /></div>
  </section>
</Layout>
