---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Fant ikke siden">
  <section class="container-x py-32 text-center" data-testid="not-found">
    <p class="eyebrow">404</p>
    <h1 class="mt-4 text-4xl font-extrabold sm:text-5xl">Fant ikke siden</h1>
    <p class="mt-4 text-slate-600">Siden kan ha blitt flyttet da nettstedet ble fornyet.</p>
    <a href="/" class="btn-primary mt-8" data-testid="not-found-home-button">Til forsiden</a>
  </section>
</Layout>
