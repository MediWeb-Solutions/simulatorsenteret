---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import ContactCta from '../components/ContactCta.astro';
import { courses } from '../data/site';

const audiences = ['Studenter i medisin og sykepleie', 'Masterstudenter i helsefag', 'Videre- og spesialistutdanning for sykepleiere og leger', 'Etterutdanning av helsepersonell i klinisk virksomhet'];
const steps = [
  { n: '01', t: 'Behov', d: 'Utgangspunktet er ofte spesifikke læringsmål fra de som skal trene og/eller ledelsen.' },
  { n: '02', t: 'Planlegging', d: 'Instruktørene går gjennom med bestilleren hva simuleringen skal fokusere på.' },
  { n: '03', t: 'Scenario', d: 'Vi lager ett eller flere scenario for å få fram den ønskede læringssituasjonen.' },
  { n: '04', t: 'Debriefing', d: 'Refleksjon som dialog mellom deltakere og fasilitator etter hver trening.' },
];
---
<Layout title="Kurs / undervisning" active="kurs">
  <PageHero eyebrow="01 / Kurs og undervisning" title="Simulatortrening for helsepersonell" lead="Medisinsk SimulatorSenter tilbyr en undervisningsmetode som er raskt voksende i utdanning av helsepersonell i store deler av verden – læring gjennom å håndtere simulerte situasjoner og reflektere over egen kunnskap og handling." image="/images/akuttmottak.jpg" />

  <section class="container-x grid gap-12 py-20 lg:grid-cols-12" data-testid="method-section">
    <div class="prose-mss lg:col-span-7">
      <h2 class="mb-6 text-3xl font-bold">Slik foregår simuleringen</h2>
      <p>Situasjonene skapes ved hjelp av avanserte datastyrte dukker og gjenspeiler scenarioer fra klinisk virksomhet. Rammene rundt scenarioene tilpasses de som skal øve med tanke på omgivelser, læringsmål, vanskelighetsgrad, tilgang på hjelpemidler osv.</p>
      <p>Refleksjon foregår som dialog mellom deltakere og fasilitator – en tradisjonell debriefing.</p>
    </div>
    <aside class="rounded-3xl bg-ice p-8 lg:col-span-5" data-testid="audience-box">
      <p class="eyebrow">Målgruppe</p>
      <ul class="mt-5 space-y-3">
        {audiences.map((a) => <li class="flex gap-3 text-slate-700"><span class="mt-2 h-2 w-2 flex-none rounded-full bg-leaf"></span>{a}</li>)}
      </ul>
    </aside>
  </section>

  <section class="bg-navy py-20" data-testid="process-section">
    <div class="container-x">
      <p class="font-mono text-xs uppercase tracking-[0.18em] text-cyan">Fra behov til trening</p>
      <h2 class="mt-3 text-3xl font-bold !text-white">Kurs tilpasset deres læringsmål</h2>
      <ol class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {steps.map((s) => (
          <li class="rounded-2xl border border-white/10 bg-white/5 p-6">
            <span class="font-mono text-sm text-cyan">{s.n}</span>
            <h3 class="mt-3 text-xl font-bold !text-white">{s.t}</h3>
            <p class="mt-2 text-sm text-slate-300">{s.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="container-x py-20" data-testid="courses-section">
    <p class="eyebrow">Eksempler</p>
    <h2 class="mt-3 text-3xl font-bold">Eksempler på kurs og simuleringer</h2>
    <div class="mt-10 grid gap-6 lg:grid-cols-3">
      {courses.map((c, i) => (
        <article class="flex flex-col rounded-3xl border border-slate-200 bg-white p-8 transition-[border-color,box-shadow] duration-300 hover:border-brand/40 hover:shadow-xl" data-testid={`course-card-${i}`}>
          <h3 class="text-2xl font-bold">{c.title}</h3>
          <p class="mt-3 flex-1 text-slate-600">{c.text}</p>
          <div class="mt-6 border-t border-slate-100 pt-5">
            <p class="font-mono text-xs uppercase tracking-wider text-slate-500">Teamet består av</p>
            <p class="mt-2 text-sm text-slate-700">{c.team}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <ContactCta />
</Layout>
